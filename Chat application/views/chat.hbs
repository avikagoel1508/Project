<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Chat Application</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <script src="/socket.io/socket.io.js"></script>
    <link rel="stylesheet" href="style.css">
</head>
<body>

    <div class="chat-app">

        <!-- Main chat window -->
        <div class="chat-card">

            <!-- Header -->
            <header class="chat-header">
                <div class="header-avatar">
                    <span class="header-avatar-initial">C</span>
                    <span class="status-dot"></span>
                </div>
                <div class="header-info">
                    <h1 class="header-title">Chat Application</h1>
                    <span class="header-status"><span class="status-pulse"></span> <span id="onlineCount">0</span> online</span>
                </div>
                <div class="header-actions">
                    <button class="icon-btn" title="Call" aria-label="Call">
                        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                    </button>
                    <button class="icon-btn" title="Menu" aria-label="Menu">
                        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="1"/><circle cx="12" cy="5" r="1"/><circle cx="12" cy="19" r="1"/></svg>
                    </button>
                </div>
            </header>

            <!-- Join screen (chat.js toggles .hidden on it after joining) -->
            <div class="userdetails" id="joinScreen">
                <div class="join-card">
                    <div class="join-emoji">
                        <svg viewBox="0 0 24 24" width="40" height="40" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
                    </div>
                    <h2>Welcome to the chat</h2>
                    <p class="join-sub">Join the conversation in real time. Pick a username to get started.</p>
                    <input type="text" placeholder="Enter Username" id="name" autocomplete="off" maxlength="24">
                    <button id="btn">Join the Chat</button>
                </div>
            </div>

            <!-- Messages -->
            <div class="messages-scroll">
                <ul class="msgList" id="msgList"></ul>
                <!-- typing indicator: chat.js can show/hide .typing -->
                <div class="typing hidden" id="typing">
                    <span class="typing-bubble">
                        <span class="dot"></span><span class="dot"></span><span class="dot"></span>
                    </span>
                </div>
            </div>

            <!-- Composer -->
            <div class="chattingapp">
                <button class="attach-btn" title="Attach" aria-label="Attach" type="button">
                    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"/></svg>
                </button>
                <input type="text" placeholder="Write the message" id="chatbox" autocomplete="off">
                <button id="btn1" class="send-btn" title="Send">
                    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
                </button>
            </div>

        </div>
    </div>

    <script src="/chat.js"></script>
</body>
</html>
